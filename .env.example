# NASA FIRMS API Key (free at https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_API_KEY=your_nasa_firms_key_here

# OpenAQ does not require a key for basic usage
OPENAQ_API_KEY=

# Optional: your city for default queries
DEFAULT_LOCATION=Mumbai

# Gemini API key, only needed for the Google ADK agent (agents/ecosentinel_agent)
# Free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
